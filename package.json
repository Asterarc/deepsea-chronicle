{
  "name": "deepsea-chronicle",
  "version": "0.1.0",
  "private": true,
  "description": "深海纪事：从 30 条模拟鱼开始的像素海洋世界",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "stop": "node scripts/stop-server.mjs",
    "dev": "node --watch server.mjs",
    "daemon": "node scripts/daemon.mjs",
    "test": "node --test",
    "world:create": "node scripts/create-world.mjs",
    "world:tick": "node scripts/world-tick.mjs",
    "render": "node scripts/render-episode.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
